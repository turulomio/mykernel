#, python-brace-format
msgid "Version detected: {0}"
msgstr "Version détectée : {0}"

msgid "Searching dependencies..."
msgstr "Recherche des dépendances..."

msgid "WARNING: Configuration file created in {}. You must set your settings. See README for help."
msgstr "ATTENTION : Fichier de configuration créé dans {}. Vous devez définir vos paramètres. Consultez le README pour de l'aide."

msgid "Configuration file {} updated with missing/obsolete keys."
msgstr "Fichier de configuration {} mis à jour avec les clés manquantes/obsolètes."

msgid "Invalid cpu_hz value '{}' in /etc/mykernel/mykernel.ini. Must be a positive integer."
msgstr "Valeur cpu_hz '{}' non valide dans /etc/mykernel/mykernel.ini. Doit être un entier positif."

msgid "Mykernel and Dracut initramfs generation is selected at the same time. Please fix it in /etc/mykernel/mykernel.ini"
msgstr "La génération d'initramfs Mykernel et Dracut est sélectionnée en même temps. Veuillez le corriger dans /etc/mykernel/mykernel.ini"

msgid "grub efi_partition cannot be empty when efi is True."
msgstr "La partition EFI de grub (efi_partition) ne peut pas être vide lorsque efi est True."

msgid "grub mbr_device cannot be empty when efi is False."
msgstr "Le périphérique MBR de grub (mbr_device) ne peut pas être vide lorsque efi est False."

msgid "My method to compile the Linux kernel"
msgstr "Ma méthode pour compiler le noyau Linux"

msgid "Write a config file in /etc/mykernel/mykernel.ini"
msgstr "Écrire un fichier de configuration dans /etc/mykernel/mykernel.ini"

msgid "Shows ccache statistics"
msgstr "Affiche les statistiques de ccache"

msgid "Error: mykernel must be run as root."
msgstr "Erreur : mykernel doit être exécuté en tant que root."

msgid "Setting CPU max scaling frequency to: {} Hz"
msgstr "Définition de la fréquence maximale de mise à l'échelle du processeur à : {} Hz"

msgid "You must set your settings in {}. See README for help."
msgstr "Vous devez définir vos paramètres dans {}. Consultez le README pour de l'aide."

msgid "Restoring CPU max scaling frequency to: {} Hz"
msgstr "Restauration de la fréquence maximale de mise à l'échelle du processeur à : {} Hz"
