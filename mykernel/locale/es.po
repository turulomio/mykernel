#, python-brace-format
msgid "Version detected: {0}"
msgstr "Versión detectada: {0}"

msgid "Searching dependencies..."
msgstr "Buscando dependencias..."

msgid "WARNING: Configuration file created in {}. You must set your settings. See README for help."
msgstr "AVISO: Archivo de configuración creado en {}. Debe establecer sus ajustes. Consulte README para obtener ayuda."

msgid "Configuration file {} updated with missing/obsolete keys."
msgstr "Archivo de configuración {} actualizado con las claves que faltaban u obsoletas."

msgid "Invalid cpu_hz value '{}' in /etc/mykernel/mykernel.ini. Must be a positive integer."
msgstr "Valor de cpu_hz '{}' no válido en /etc/mykernel/mykernel.ini. Debe ser un entero positivo."

msgid "Mykernel and Dracut initramfs generation is selected at the same time. Please fix it in /etc/mykernel/mykernel.ini"
msgstr "La generación de initramfs de Mykernel y Dracut está seleccionada al mismo tiempo. Por favor, corrígelo en /etc/mykernel/mykernel.ini"

msgid "grub efi_partition cannot be empty when efi is True."
msgstr "La partición EFI de grub (efi_partition) no puede estar vacía cuando efi es True."

msgid "grub mbr_device cannot be empty when efi is False."
msgstr "El dispositivo MBR de grub (mbr_device) no puede estar vacío cuando efi es False."

msgid "My method to compile the Linux kernel"
msgstr "Mi método para compilar el kernel de Linux"

msgid "Write a config file in /etc/mykernel/mykernel.ini"
msgstr "Escribe un fichero de configuración en /etc/mykernel/mykernel.ini"

msgid "Shows ccache statistics"
msgstr "Muestra estadísticas de ccache"

msgid "Error: mykernel must be run as root."
msgstr "Error: mykernel debe ejecutarse como root."

msgid "Setting CPU max scaling frequency to: {} Hz"
msgstr "Estableciendo frecuencia máxima de escalado de CPU a: {} Hz"

msgid "You must set your settings in {}. See README for help."
msgstr "Debe establecer sus ajustes en {}. Consulte README para obtener ayuda."

msgid "Restoring CPU max scaling frequency to: {} Hz"
msgstr "Restaurando frecuencia máxima de escalado de CPU a: {} Hz"
